<!DOCTYPE html>
<html>
<head>
  <title>RWA Rental DApp</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4">
  <h1>RWA Rental Dashboard</h1>

  <table class="table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Location</th>
      </tr>
    </thead>
    <tbody>
      {{range .properties}}
      <tr>
        <td>{{.id}}</td>
        <td>{{.name}}</td>
        <td>{{.location}}</td>
      </tr>
      {{end}}
    </tbody>
  </table>
</body>
</html>
